{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RevisionMutation",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "changedPaths"],
  "properties": {
    "intent": {"type": "string", "enum": ["UPDATE_THEME", "UPDATE_COPY", "ADD_SERVICE", "UPDATE_CONTACT"]},
    "changedPaths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(theme|meta|hero|about|services|contact)(\\..+)?$"}
    },
    "theme": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "primaryColor": {"type": "string", "pattern": "^#([A-Fa-f0-9]{6})$"},
        "accentColor": {"type": "string", "pattern": "^#([A-Fa-f0-9]{6})$"},
        "fontFamily": {"type": "string", "enum": ["sans", "serif", "display"]}
      }
    },
    "meta": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "businessName": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "tagline": {"type": "string", "minLength": 1}
      }
    },
    "hero": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string", "minLength": 1},
        "ctaText": {"type": "string", "minLength": 1},
        "ctaWhatsappMessage": {"type": "string", "minLength": 1}
      }
    },
    "about": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "story": {"type": "string", "minLength": 1},
        "highlights": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "services": {
      "type": "object", "additionalProperties": false, "required": ["append"],
      "properties": {
        "append": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "description", "priceEstimate"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "description": {"type": "string", "minLength": 1},
              "priceEstimate": {"type": "string", "minLength": 1},
              "iconKeyword": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "contact": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "whatsappNumber": {"type": ["string", "null"], "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "instagram": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"intent": {"const": "UPDATE_THEME"}}}, "then": {"required": ["theme"]}},
    {"if": {"properties": {"intent": {"const": "UPDATE_COPY"}}}, "then": {"anyOf": [{"required": ["meta"]}, {"required": ["hero"]}, {"required": ["about"]}]}},
    {"if": {"properties": {"intent": {"const": "ADD_SERVICE"}}}, "then": {"required": ["services"]}},
    {"if": {"properties": {"intent": {"const": "UPDATE_CONTACT"}}}, "then": {"required": ["contact"]}}
  ]
}
